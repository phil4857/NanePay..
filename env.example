# ── SERVER ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── DATABASE (Render PostgreSQL) ──────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/nanepay_db
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_EXPIRES_IN=7d

# ── BCRYPT ────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── M-PESA ────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://your-app.onrender.com/api/mpesa/callback
MPESA_B2C_RESULT_URL=https://your-app.onrender.com/api/mpesa/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-app.onrender.com/api/mpesa/b2c/timeout

# ── FEES ──────────────────────────────────────────────────────
TRANSFER_FEE_RATE=0.01
MERCHANT_FEE_RATE=0.008
FOREX_MARKUP_PCT=0.02
INVESTMENT_SPREAD=0.015

# ── FRONTEND ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
